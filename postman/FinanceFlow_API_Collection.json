        {
          "name": "Get Budgets with Real-time Progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/budgets?month=9&year=2026",
              "host": ["{{baseUrl}}"],
              "path": ["api", "budgets"],
              "query": [
                {
                  "key": "month",
                  "value": "9"
                },
                {
                  "key": "year",
                  "value": "2026"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains progress metrics\", function () {",
                  "    var json = pm.response.json();",
                  "    if (json.data.length > 0) {",
                  "        pm.expect(json.data[0]).to.have.property('amountSpent');",
                  "        pm.expect(json.data[0]).to.have.property('percentageUsed');",
                  "        pm.expect(json.data[0]).to.have.property('status');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
