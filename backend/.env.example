# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# For Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/FinanceFlow?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/PFT

# JWT Signing Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Production Frontend Client URL (For CORS whitelist)
CLIENT_URL=https://your-financeflow.vercel.app
